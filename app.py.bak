            <span>Person</span>
            <span>Pose</span>
            <span>Sensor</span>
            <span>Fusion</span>
            <span>AI</span>
            <span>Alert</span>
        </div>
    </div>
    <div style="margin-top:14px; color:#94A3B8; font-size:0.85rem;">Live • {}</div>
</div>
'''.format(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))

# Streamlit fragment to run every second.
# This updates metric values, charts, and incidents tables without page reloads or interrupting user inputs.
@st.fragment(run_every=1)
def update_dashboard_data():
    try:
        # Fetch status, metrics, stats
        res_status = requests.get(API_STATUS, timeout=1.0)
        res_metrics = requests.get(API_METRICS, timeout=1.0)
        res_stats = requests.get(API_STATS, timeout=1.0)
        
        status_data = res_status.json() if res_status.status_code == 200 else {}
        metrics_history_data = res_metrics.json() if res_metrics.status_code == 200 else []
        stats_data = res_stats.json() if res_stats.status_code == 200 else {}
    except Exception as e:
        with center_placeholder.container():
            st.error(f"Cannot connect to Fusion Engine at {API_STATUS}.")
            st.warning("Please verify that the FastAPI backend server is running on port 8000.")
            st.info("Start the FastAPI server: `uvicorn fusion.main:app --port 8000 --reload` in your terminal.")
            st.info("Start the telemetry mock client: `python mock_client.py` in your terminal.")
        return

    # Extract Telemetry & Status
    telemetry = status_data.get("telemetry", {})
    mission_state = status_data.get("mission", "NORMAL")
    trust_score = status_data.get("trust_score", 0.0)
    explanation = status_data.get("explanation", "Waiting for telemetry update...")
    last_timestamp = status_data.get("timestamp")
    has_telemetry = bool(telemetry)

    # Ensure risk_history is initialized before use
    if "risk_history" not in st.session_state:
        st.session_state.risk_history = [0.0] * 60
    # Ensure selected language is initialized
    if "selected_lang" not in st.session_state:
        st.session_state.selected_lang = "English"

    # Update risk history for sparkline
    st.session_state.risk_history.append(trust_score)
    if len(st.session_state.risk_history) > 60:
        st.session_state.risk_history.pop(0)

    # Use actual Arduino telemetry values instead of simulation
    light_val = telemetry.get("light", 0.0)
    water_val = telemetry.get("water", 0.0)
    rain_val = telemetry.get("rain", False)
    temp_val = telemetry.get("temp")
    humidity_val = telemetry.get("humidity")
    relay_val = telemetry.get("relay", "off")
    led_val = telemetry.get("led_rgb", "unknown")
    buzzer_val = telemetry.get("buzzer", "silent")
    phone_val = telemetry.get("phone", 0.0)
    movement_val = telemetry.get("movement", 0.0)

    # Connection health and formatted telemetry values
    telemetry_connection = "Disconnected"
    last_updated_str = "--"
    if last_timestamp:
        try:
            last_dt = datetime.datetime.fromisoformat(last_timestamp)
            last_updated_str = last_dt.strftime('%H:%M:%S')
            if (datetime.datetime.now() - last_dt).total_seconds() <= 5:
                telemetry_connection = "Live"
        except Exception:
            last_updated_str = last_timestamp
            telemetry_connection = "Disconnected"

    def fmt_num(value, fmt):
        return fmt.format(value) if isinstance(value, (int, float)) else "--"

    water_text = fmt_num(water_val, "{:.2f} m")
    flow_text = fmt_num(movement_val, "{:.2f} m/s")
    temp_text = fmt_num(temp_val, "{:.1f}°C")
    humidity_text = fmt_num(humidity_val, "{:.1f}%")
    light_text = fmt_num(light_val, "{:.1f}")
    rain_text = "--"
    if rain_val is not None and rain_val != "":
        rain_str = str(rain_val).strip().lower()
        if rain_str in ("1", "true", "yes", "on"): rain_text = "Yes"
        elif rain_str in ("0", "false", "no", "off"): rain_text = "No"
        else: rain_text = str(rain_val)

    gps_val = telemetry.get("gps")
    if isinstance(gps_val, dict):
        gps_text = f"{gps_val.get('lat', '--')}, {gps_val.get('lon', '--')}"
    elif gps_val is None or gps_val == "":
        gps_text = "--"
    else:
        gps_text = str(gps_val)

    phone_text = "Disconnected"
    if phone_val is not None and phone_val != "":
        phone_str = str(phone_val).strip().lower()
        if phone_str not in ("0", "false", "none", "off", ""):
            phone_text = "Connected"

    sensor_text = telemetry.get("health", "--")
    sensor_text = sensor_text.capitalize() if isinstance(sensor_text, str) else str(sensor_text)

    # 1. Update Center Column
    with center_placeholder.container():
        st.markdown('<div class="glass-card" style="text-align:center;">', unsafe_allow_html=True)
        st.subheader("Mission State Status")
        
        # Render Glowing State Banner
        if mission_state == "EMERGENCY":
            banner_cls = "banner-emergency"
            badge_lbl = "🚨 EMERGENCY ACTIVE"
        elif mission_state == "DISTRESS":
            banner_cls = "banner-distress"
            badge_lbl = "⚠️ DISTRESS ENFORCED"
        elif mission_state == "SUSPICIOUS":
            banner_cls = "banner-suspicious"
            badge_lbl = "🔍 SUSPICIOUS STATE"
        elif mission_state == "OBSERVE":
            banner_cls = "banner-observe"
            badge_lbl = "👁️ OBSERVATION STATE"
        else:
            banner_cls = "banner-normal"
            badge_lbl = "✅ STATE: NORMAL"

        if not has_telemetry:
            badge_lbl = "⏳ WAITING FOR COM3 TELEMETRY"
            banner_cls = "banner-observe"
            
        st.markdown(f"""
        <div class="{banner_cls}">
            <h2 style="margin:0; font-size: 1.8rem; font-weight: 800; font-family: sans-serif;">{badge_lbl}</h2>
        </div>
        """, unsafe_allow_html=True)
        
        # Risk gauge dial
        col_g1, col_g2, col_g3 = st.columns([1, 2, 1])
        with col_g2:
            st.markdown(make_svg_gauge(trust_score), unsafe_allow_html=True)
            
        # GenieX Explanation Card
        st.markdown("""
        <div style="background: rgba(31, 41, 55, 0.6); padding: 1rem; border-radius: 8px; border: 1px dashed rgba(255,255,255,0.15); margin-top: 1rem;">
            <span style="color: #10b981; font-weight: bold; font-size: 0.85rem; letter-spacing: 0.05em;">GENIEX EXPLAINABILITY</span>
        """, unsafe_allow_html=True)
        st.write(explanation)
        st.markdown("</div>", unsafe_allow_html=True)
        st.markdown('</div>', unsafe_allow_html=True)

        # 2. Update Right Column — premium stacked glass cards
        with right_placeholder.container():
                # Live Camera Card
                cam_fps = stats_data.get('camera_fps', '—') if isinstance(stats_data, dict) else '—'
                cam_latency = stats_data.get('camera_latency_ms', '—') if isinstance(stats_data, dict) else '—'
                st.markdown(f"""
                <div class="glass-card" style="margin-bottom:10px;">
                    <div style="display:flex; gap:12px; align-items:center;">
                        <div style="flex:1;">
                            <div style="font-weight:700; color:#e6f7ff;">Live Camera Feed</div>
                            <div style="margin-top:8px; border-radius:12px; overflow:hidden; background:#081723; height:120px; display:flex; align-items:center; justify-content:center;">
                                <div style="color:#9ca3af">Camera Preview</div>
                            </div>
                        </div>
                        <div style="width:120px; display:flex; flex-direction:column; gap:8px;">
                            <div style="background:rgba(255,255,255,0.02); padding:8px; border-radius:10px; text-align:center;">FPS<br><strong style="color:#e6f7ff">{cam_fps}</strong></div>
                            <div style="background:rgba(255,255,255,0.02); padding:8px; border-radius:10px; text-align:center;">Latency<br><strong style="color:#9fbfcf">{cam_latency} ms</strong></div>
                            <div style="background:linear-gradient(90deg,#023E8A,#48CAE4); padding:6px; border-radius:8px; text-align:center; color:#fff; font-weight:700;">AI: Online</div>
                        </div>
                    </div>
                </div>
                """, unsafe_allow_html=True)

                # Fusion Engine Card
                fusion_conf = status_data.get('fusion_confidence', None)
                sensor_health = telemetry.get('health', 'healthy')
                cpu_pct = stats_data.get('cpu_percent', '—') if isinstance(stats_data, dict) else '—'
                ram_pct = stats_data.get('ram_percent', '—') if isinstance(stats_data, dict) else '—'
                st.markdown(f"""
                <div class="glass-card" style="margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-weight:700; color:#e6f7ff;">Fusion Engine</div>
                            <div style="color:#9ca3af; font-size:13px;">Trust Score: <strong style='color:#e6f7ff'>{int(trust_score*100)}%</strong></div>
                        </div>
                        <div style="display:flex; gap:8px;">
                            <div style="text-align:center; padding:8px; border-radius:8px; background:rgba(255,255,255,0.02)">CPU<br><strong>{cpu_pct}%</strong></div>
                            <div style="text-align:center; padding:8px; border-radius:8px; background:rgba(255,255,255,0.02)">RAM<br><strong>{ram_pct}%</strong></div>
                        </div>
                    </div>
                    <div style="margin-top:10px; display:flex; gap:10px; align-items:center;">
                        <div style="flex:1">{make_svg_gauge(trust_score)}</div>
                        <div style="width:120px; text-align:center;">Sensor Health<br><strong style="color:#e6f7ff">{sensor_health.upper()}</strong></div>
                    </div>
                </div>
                """, unsafe_allow_html=True)

                # GenieX Explainability Card
                st.markdown("""
                <div class="glass-card" style="margin-bottom:10px;">
                    <div style="font-weight:700; color:#e6f7ff;">GenieX Explainability</div>
                    <div style="margin-top:8px; color:#9ca3af; font-size:13px;">Decision Summary</div>
                """, unsafe_allow_html=True)
                st.write(explanation)
                st.markdown("""
                    <div style="margin-top:8px; display:flex; gap:8px;">
                        <div style="flex:1; background:rgba(255,255,255,0.02); padding:8px; border-radius:8px;">Trust: <strong>{:.0%}</strong></div>
                    </div>
                </div>
                """ .format(trust_score), unsafe_allow_html=True)

                # Arduino Telemetry Card
                st.markdown(f"""
                <div class="glass-card" style="margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <div style="font-weight:700; color:#e6f7ff;">Arduino Telemetry</div>
                        <div style="font-size:0.85rem; color:{'#34D399' if telemetry_connection == 'Live' else '#FBBF24'}; font-weight:700;">{telemetry_connection}</div>
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px;">
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Water Level</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{water_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Flow Speed</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{flow_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Temperature</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{temp_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Humidity</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{humidity_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Rain Sensor</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{rain_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Light Sensor</div><div style="font-size:1.2rem; font-weight:700; color:#e6f7ff;">{light_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">GPS</div><div style="font-size:1rem; font-weight:700; color:#e6f7ff;">{gps_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Phone</div><div style="font-size:1rem; font-weight:700; color:#e6f7ff;">{phone_text}</div></div>
                        <div style="padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Sensor Status</div><div style="font-size:1rem; font-weight:700; color:#e6f7ff;">{sensor_text}</div></div>
                        <div style="grid-column: span 2; padding:12px; background:rgba(255,255,255,0.03); border-radius:12px;"><div style="font-size:0.75rem; color:#94A3B8;">Last Updated</div><div style="font-size:1rem; font-weight:700; color:#e6f7ff;">{last_updated_str}</div></div>
                    </div>
                </div>
                """, unsafe_allow_html=True)

                # Sarvam Alerts Card
                st.markdown(f"""
                <div class="glass-card" style="margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="font-weight:700; color:#e6f7ff;">Sarvam Alerts</div>
                        <div style="color:#9ca3af;">Language: <strong>{st.session_state.selected_lang}</strong></div>
                    </div>
                    <div style="margin-top:8px; display:flex; gap:8px;">
                        <div style="flex:1; padding:8px; background:rgba(255,255,255,0.02); border-radius:8px;">Voice Alert: <strong>Enabled</strong></div>
                        <div style="flex:1; padding:8px; background:rgba(255,255,255,0.02); border-radius:8px;">SMS: <strong>Ready</strong></div>
                    </div>
                </div>
                """, unsafe_allow_html=True)

                # Cloud Escalation Card
                total_inc = stats_data.get('total_incidents', 0) if isinstance(stats_data, dict) else 0
                cloud_sync = stats_data.get('cloud_synced', False) if isinstance(stats_data, dict) else False
                st.markdown(f"""
                <div class="glass-card">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="font-weight:700; color:#e6f7ff;">Cloud Escalation</div>
                        <div style="color:#9ca3af;">Incidents: <strong>{total_inc}</strong></div>
                    </div>
                    <div style="margin-top:10px;">Cloud Sync: <strong style='color:{'#00E676' if cloud_sync else '#9ca3af'}'>{'Yes' if cloud_sync else 'No'}</strong></div>
                </div>
                """, unsafe_allow_html=True)

    # 3. Update Bottom Section (Charts & Incident Logs)
    with bottom_placeholder.container():
        col_b1, col_b2 = st.columns([5, 5])
        
        # Left: Performance charts
        with col_b1:
            st.markdown('<div class="glass-card">', unsafe_allow_html=True)
            st.subheader("Performance Logs (Latency, CPU, RAM)")
            # Load dynamic Chart.js panel that connects directly to WebSocket (no pyarrow dependencies!)
            components.html(CHARTS_HTML_TEMPLATE, height=360)
            st.markdown('</div>', unsafe_allow_html=True)
            
        # Right: Incidents Table & Heatmap
        with col_b2:
            st.markdown('<div class="glass-card">', unsafe_allow_html=True)
            st.subheader("Cloud Escalation & Incident Heatmap")
            
            if stats_data and stats_data.get("total_incidents", 0) > 0:
                st.write(f"Total Incidents Logged: **{stats_data.get('total_incidents')}** | Cloud Escalated: **{stats_data.get('cloud_escalated_count')}**")
                
                dist = stats_data.get("state_distribution", {})
                col_st1, col_st2, col_st3, col_st4 = st.columns(4)
                col_st1.metric("Observe", dist.get("OBSERVE", 0))
                col_st2.metric("Suspicious", dist.get("SUSPICIOUS", 0))
                col_st3.metric("Distress", dist.get("DISTRESS", 0))
                col_st4.metric("Emergency", dist.get("EMERGENCY", 0))
                
                # Fetch recent incidents list from endpoint
                try:
                    res_inc = requests.get(API_INCIDENTS, timeout=1.0)
                    if res_inc.status_code == 200:
                        inc_list = res_inc.json()
                        if inc_list:
                            st.write("**Recent Logs:**")
                            log_df = pd.DataFrame(inc_list[-5:])
                            log_df['time'] = log_df['timestamp'].apply(lambda x: pd.to_datetime(x).strftime('%m-%d %H:%M:%S') if pd.notnull(x) else '')
                            st.dataframe(log_df[['time', 'state', 'trust_score', 'cloud_escalated', 'second_opinion_verdict']], use_container_width=True)
                except Exception as e:
                    print(f"Could not load recent incidents: {e}")
            else:
                st.info("No logs recorded yet. Escalate state to SUSPICIOUS, DISTRESS, or EMERGENCY to view entries.")
            st.markdown('</div>', unsafe_allow_html=True)

    # Add mission biometrics at the bottom of the dashboard
    st.markdown('<div class="glass-card" style="margin: 14px 28px 28px; padding: 20px;">', unsafe_allow_html=True)
    st.subheader("Mission Biometrics")
    col_m1, col_m2, col_m3, col_m4 = st.columns(4)
    col_m1.metric("Risk", "7%")
    col_m2.metric("Trust", "97%")
    col_m3.metric("FPS", "29")
    col_m4.metric("Latency", "23ms")
    st.markdown('</div>', unsafe_allow_html=True)

# Run the update dashboard loop
update_dashboard_data()

